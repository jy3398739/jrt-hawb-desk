{
  "name": "CCSP 航空物流信息服务平台（中国航信/天信达）",
  "version": "V2-M1",
  "recon_date": "2026-09-26",
  "login_url": "http://www.infoccsp.com/sso/sso-login.do",
  "notes": [
    "登录表单字段 companyCode/username/password/webLoginCheckCode(图形验证码)，POST 回同址；会话走 URL 重写(;jsessionid=…)。",
    "分单录入入口 /fas/hawb/HAWBAction.do：先 mawbVirtualForm 建虚拟主单（写操作），详情表单 editHAWBForm。",
    "提交前平台强制确认货名与 HS 码（needCargoNameConfirm/needHsCodeConfirm）。",
    "侦察样本=已发送真票 999-95764373/VCE4373 等 8 张，字段面见 docs/V2-ccsp-hawb-mapping.md。"
  ],
  "detail_url_template": "/fas/hawb/HAWBAction_initAddHAWB.do?hmr.mawb.awbPre={awb_pre}&hmr.mawb.awbNo={awb_no}&hmr.hawb.hawbNo={hawb_no}",
  "field_map": {
    "MAWB_NO": {"targets": {"hmr.mawb.awbPre": "split_mawb_pre", "hmr.mawb.awbNo": "split_mawb_no"}},
    "ORIGIN_NAME": {"targets": {"hmr.hawb.originAirport": "city_to_airport"}},
    "DEST_NAME": {"targets": {"hmr.hawb.destAirport": "city_to_airport"}},
    "HAWB_NO": {"targets": {"hmr.hawb.hawbNo": "plain"}},
    "GOODS_INFO": {"targets": {"hmr.hawb.cargoName": "plain"}},
    "GOODS_HS_CODE": {"targets": {"hmr.hawb.hsCode": "hs6"}},
    "PIECES": {"targets": {"hmr.hawb.pcs": "plain"}},
    "SLAC": {"targets": {"hmr.hawb.slac": "plain"}},
    "WEIGHT": {"targets": {"hmr.hawb.grossWt": "weight"}},
    "SHIPPER_INFO": {"prefix": "hmr.hawb.shipper.", "sub": {
      "COMP_NAME": "name", "COMP_ADDRESS": "address", "CITY": "city", "STATE": "state",
      "COUNTRY": "country", "POSTAL": "zipCode", "TEL": "tel", "FAX": "fax",
      "TAX_ID": "customsCode", "AEO": "AEOCode"}},
    "CONSIGNEE_INFO": {"prefix": "hmr.hawb.consignee.", "sub": {
      "COMP_NAME": "name", "COMP_ADDRESS": "address", "CITTY": "city", "STATE": "state",
      "COUNTRY": "country", "POSTAL": "zipCode", "TEL": "tel", "FAX": "fax",
      "TAX_ID": "customsCode", "AEO": "AEOCode"}}
  },
  "platform_only": [
    "hmr.hawb.currency", "hmr.hawb.valuePaymode", "hmr.hawb.othfeePaymode",
    "hmr.hawb.transportDeclarevalue", "hmr.hawb.transportInsurancevalue", "hmr.hawb.customsDeclarevalue",
    "hmr.hawb.specHandingCode", "hmr.hawb.shipper.poBox", "hmr.hawb.consignee.poBox",
    "hmr.hawb.consignee.customsContact", "hmr.hawb.consignee.customsContactNum"
  ],
  "human_fill_candidates": [
    "hmr.hawb.shipper.city", "hmr.hawb.shipper.zipCode", "hmr.hawb.shipper.tel",
    "hmr.hawb.consignee.city", "hmr.hawb.consignee.zipCode", "hmr.hawb.consignee.tel",
    "hmr.hawb.consignee.customsCode"
  ],
  "human_fill_note": "八票对格实证：平台人工的 city/zip/tel 常来自平台收发货人库而非票面（8 张里 6 张 shipper zip=101312 模板值）。这些控件我方为空时列入人工核对清单，不要当成提取缺陷。",
  "city_to_airport": {
    "BJS": "PEK",
    "MIL": "MXP",
    "YMQ": "YUL",
    "STO": "ARN",
    "ROM": "FCO",
    "LON": "LHR",
    "PAR": "CDG",
    "CHI": "ORD",
    "NYC": "JFK",
    "WAS": "IAD",
    "MOW": "SVO",
    "BUE": "EZE",
    "SAO": "GRU",
    "TYO": "NRT",
    "SEL": "ICN",
    "SHA": "PVG",
    "CAN": "CAN"
  },
  "city_to_airport_note": "票面/我方 L3 用 IATA 城市组码，CCSP 人工口径一律填主机场码（8/8 张对格实证）。未收录的码原样保留并列入 needs_human。"
}
